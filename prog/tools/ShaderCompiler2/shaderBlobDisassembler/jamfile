WinSdkVer  = win.sdk.100 ;

PlatformArch_windows ?= x86_64 ;
PlatformSpec_windows ?= clang ;

Root    ?= ../../../.. ;
Location = prog/tools/ShaderCompiler2/shaderBlobDisassembler ;

TargetType = lib ;
Target = tools/shaderBlobDisassembler.lib ;

Sources +=
  disasm.cpp
  debugSpitfile.cpp
;

AddIncludes =
  $(Root)/prog/gameLibs/publicInclude
;

UseProgLibs =
  3rdPartyLibs/regExp
  3rdPartyLibs/vulkan/spirv-tools
  gameLibs/shaderBlobUnpack
;

if $(Platform) in windows linux macOS {

  AddIncludes +=
    $(Root)/prog/3rdPartyLibs/vulkan/include
    $(Root)/prog/3rdPartyLibs/vulkan/spirv-tools/include
  ;

  if $(Platform) = windows {
    UseProgLibs +=
      gameLibs/dxil
    ;
  }

} else {
  Exit Platform=$(Platform) is not supported! ;
}

include $(Root)/prog/_jBuild/build.jam ;
