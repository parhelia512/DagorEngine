// tree crowns come from the baked media volumes (voxelizedMedia lib) injected on refill, not
// from trees2d: this project override of the daGI2 initial media hook samples the per instance
// grid the project fills each refill region (see RendInstMediaVolumes::gather)
include "dagi_media_volumes_inject.dshl"

// the media volumes own density now: the gbuf pass must only refresh radiance, its screen
// estimate would erode the crowns the bake resolves. at include time, not in the macro:
// a consumer #ifndef default must never win by expansion order
hlsl {
  #define DAGI_MEDIA_DENSITY_FROM_REFILL 1
}

macro PROJECT_GI_MEDIA(code)
  hlsl(code) {
    float4 dagi_get_project_media(float3 worldPos, float voxelSize)//incoming light scattering + density
    {
      //fixme: add volfog
      return 0;
    }
  }
endmacro

macro PROJECT_GI_INITIAL_MEDIA(code)
  if (!hardware.dx11)
  {
    // the refill cs binds the media scene: the volumes canopy self occlusion reads its
    // coarser clip (fp16 typed uav load). the initial media hook is only used there
    hlsl(code) {
      #define DAGI_MEDIA_VOLS_ATTEN_FROM_SCENE 1
    }
  }
  DAGI_MEDIA_VOLUMES(code)
  PROJECT_GI_MEDIA(code)
  hlsl(code) {
    float4 dagi_get_project_initial_media(float3 worldPos, float voxelSize)//scattering + transmittance
    {
      // the volfog source to come is capped apart (see the fixme; the cap sits far above any
      // lit color, in effect it bounds density); the refill cs bounds the sum
      return clamp(dagi_get_project_media(worldPos, voxelSize), 0, 4096.f) + dagi_media_volumes(worldPos, voxelSize);
    }
  }
endmacro
