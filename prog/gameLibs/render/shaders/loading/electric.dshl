include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_electric,
  loading_splash_electric_1,
  loading_splash_electric_2,
  loading_splash_electric_3,
  loading_splash_electric_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_electric_1, loading_splash_electric_2, loading_splash_electric_3, loading_splash_electric_4)

  hlsl(ps) {
    #include <loading/electric.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_electric, loading_splash_electric_1, loading_splash_electric_2, loading_splash_electric_3, loading_splash_electric_4)
}
