include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_rgbTriangle,
  loading_splash_rgbTriangle_1,
  loading_splash_rgbTriangle_2,
  loading_splash_rgbTriangle_3,
  loading_splash_rgbTriangle_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_rgbTriangle_1, loading_splash_rgbTriangle_2, loading_splash_rgbTriangle_3, loading_splash_rgbTriangle_4)

  hlsl(ps) {
    #include <loading/rgbTriangle.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_rgbTriangle, loading_splash_rgbTriangle_1, loading_splash_rgbTriangle_2, loading_splash_rgbTriangle_3, loading_splash_rgbTriangle_4)
}
