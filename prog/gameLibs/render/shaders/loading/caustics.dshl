include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_caustics,
  loading_splash_caustics_1,
  loading_splash_caustics_2,
  loading_splash_caustics_3,
  loading_splash_caustics_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_caustics_1, loading_splash_caustics_2, loading_splash_caustics_3, loading_splash_caustics_4)

  hlsl(ps) {
    #include <loading/caustics.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_caustics, loading_splash_caustics_1, loading_splash_caustics_2, loading_splash_caustics_3, loading_splash_caustics_4)
}
