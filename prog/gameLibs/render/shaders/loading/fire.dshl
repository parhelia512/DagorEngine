include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_fire,
  loading_splash_fire_1,
  loading_splash_fire_2,
  loading_splash_fire_3,
  loading_splash_fire_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_fire_1, loading_splash_fire_2, loading_splash_fire_3, loading_splash_fire_4)

  hlsl(ps) {
    #include <loading/fire.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_fire, loading_splash_fire_1, loading_splash_fire_2, loading_splash_fire_3, loading_splash_fire_4)
}
