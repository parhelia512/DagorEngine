include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_worley,
  loading_splash_worley_1,
  loading_splash_worley_2,
  loading_splash_worley_3,
  loading_splash_worley_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_worley_1, loading_splash_worley_2, loading_splash_worley_3, loading_splash_worley_4)

  hlsl(ps) {
    #include <loading/worley.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_worley, loading_splash_worley_1, loading_splash_worley_2, loading_splash_worley_3, loading_splash_worley_4)
}
