include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_watery,
  loading_splash_watery_1,
  loading_splash_watery_2,
  loading_splash_watery_3,
  loading_splash_watery_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_watery_1, loading_splash_watery_2, loading_splash_watery_3, loading_splash_watery_4)

  hlsl(ps) {
    #include <loading/watery.glsl>
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_watery, loading_splash_watery_1, loading_splash_watery_2, loading_splash_watery_3, loading_splash_watery_4)
}
