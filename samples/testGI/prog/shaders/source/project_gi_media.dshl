// the tree canopy media comes from the voxelizedMedia lib: this project override of the
// daGI2 initial media hook (dagi_media_project_defined.dshl) samples the per instance grid
// the project fills each refill region (see DaGIMediaVolumes::setRegionInstances)
include "dagi_media_volumes_inject.dshl"

macro PROJECT_GI_MEDIA(code)
  hlsl(code) {
    // the media volumes own density now: the gbuf pass must only refresh radiance, its screen
    // estimate would erode the crowns the bake resolves
    #define DAGI_MEDIA_DENSITY_FROM_REFILL 1
    float4 dagi_get_project_media(float3 worldPos, float voxelSize)//incoming light scattering + density
    {
      return 0;
    }
  }
endmacro

macro PROJECT_GI_INITIAL_MEDIA(code)
  if (hardware.dx11) {} else
  {
    // the refill cs binds the media scene: the volumes canopy self occlusion reads its
    // coarser clip (fp16 typed uav load). the initial media hook is only used there
    hlsl(code) {
      #define DAGI_MEDIA_VOLS_ATTEN_FROM_SCENE 1
    }
  }
  DAGI_MEDIA_VOLUMES(code)
  PROJECT_GI_MEDIA(code)
  hlsl(code) {
    float4 dagi_get_project_initial_media(float3 worldPos, float voxelSize)//scattering + density
    {
      // the cap keeps the whole term fp16 finite, lit color and density alike: an inf
      // would ride the media scene's temporal lerp forever. the zero project term
      // carries no cap of its own
      return dagi_get_project_media(worldPos, voxelSize)
        + clamp(dagi_media_volumes(worldPos, voxelSize), 0, 4096.f);
    }
  }
endmacro
