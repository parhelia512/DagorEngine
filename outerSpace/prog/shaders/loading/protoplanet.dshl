include "shader_global.dshl"
include "loading_splash_common.dshl"

shader loading_splash_protoplanet,
  loading_splash_protoplanet_1,
  loading_splash_protoplanet_2,
  loading_splash_protoplanet_3,
  loading_splash_protoplanet_4
{
  LOADING_SPLASH_STATE()
  LOADING_SPLASH_PS_OUTPUT(loading_splash_protoplanet_1, loading_splash_protoplanet_2, loading_splash_protoplanet_3, loading_splash_protoplanet_4)

  hlsl(ps) {
    // DXC -Werror,-Wparameter-usage flags an unread out param in the scene; force inout.
    #define out inout
    #include "protoplanet.glsl"
    #undef out
  }

  LOADING_SPLASH_PS_MAIN(loading_splash_protoplanet, loading_splash_protoplanet_1, loading_splash_protoplanet_2, loading_splash_protoplanet_3, loading_splash_protoplanet_4)
}
